{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn"
  },
  "ignorePatterns": [
    "example/**",
    "coverage/**"
  ],
  "overrides": [
    {
      "files": [
        "__tests__/**",
        "__mocks__/**"
      ],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}
