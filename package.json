{
  "name": "@mhmdiqbal/react-native-map-clustering",
  "version": "5.0.0",
  "description": "React Native Map Clustering both for Android and iOS. Fork of react-native-map-clustering by Venits.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "bob build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:build": "bob build && tsc -p smoke && jest --coverage=false --testMatch '<rootDir>/smoke/**/*.smoke.tsx'",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run test:build",
    "example:setup": "bob build && npm pack --ignore-scripts --pack-destination example && npm --prefix example install ./example/mhmdiqbal-react-native-map-clustering-5.0.0.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmdiqbal/react-native-map-clustering.git"
  },
  "keywords": [
    "react-native",
    "react",
    "cluster",
    "android",
    "iOS",
    "map",
    "clustering"
  ],
  "author": "Muhamad Iqbal",
  "contributors": [
    "Venits (original author, https://github.com/tomekvenits/react-native-map-clustering)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mhmdiqbal/react-native-map-clustering/issues"
  },
  "homepage": "https://github.com/mhmdiqbal/react-native-map-clustering#readme",
  "dependencies": {
    "@types/supercluster": "^7.1.3",
    "supercluster": "^8.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-maps": "*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "oxlint": "^1.85.0",
    "react-native-builder-bob": "^0.43.1",
    "test-renderer": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(supercluster|kdbush)/)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/types.ts"
    ],
    "coverageReporters": [
      "text"
    ],
    "coverageThreshold": {
      "./src/**/*.{ts,tsx}": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^react-native-maps$": "<rootDir>/__mocks__/react-native-maps.ts"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
