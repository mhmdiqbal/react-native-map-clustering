{
  "name": "@mhmdiqbal/react-native-map-clustering",
  "version": "4.0.2",
  "description": "React Native Map Clustering both for Android and iOS. Fork of react-native-map-clustering by Venits.",
  "types": "index.d.ts",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "test": "jest",
    "prepublishOnly": "npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmdiqbal/react-native-map-clustering.git"
  },
  "keywords": [
    "react-native",
    "react",
    "cluster",
    "android",
    "iOS",
    "map",
    "clustering"
  ],
  "author": "Muhamad Iqbal",
  "contributors": [
    "Venits (original author, https://github.com/tomekvenits/react-native-map-clustering)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mhmdiqbal/react-native-map-clustering/issues"
  },
  "homepage": "https://github.com/mhmdiqbal/react-native-map-clustering#readme",
  "dependencies": {
    "supercluster": "^8.0.0"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-maps": "*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "oxlint": "^1.85.0",
    "test-renderer": "^1.3.0"
  },
  "jest": {
    "transform": {
      "\\.js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(supercluster|kdbush)/)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "index.js",
      "lib/**/*.js"
    ],
    "coverageReporters": [
      "text"
    ],
    "coverageThreshold": {
      "./index.js": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      },
      "./lib/**/*.js": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
